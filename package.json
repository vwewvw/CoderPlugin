{
  "name": "vibecoderplugin",
  "displayName": "CoderPlugin",
  "description": "Plugin for lab 3",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "vibecoder.hello", "title": "Hello World", "icon": "$(smiley)" },
      { "command": "vibecoder.contextAction", "title": "Команда из меню" },
      { "command": "vibecoder.countLines", "title": "Подсчитать строки", "icon": "$(list-unordered)" },
      { "command": "jokeGenerator.getJoke", "title": "Случайная шутка", "icon": "$(smiley)" },
      { "command": "gitMaster.startQuiz", "title": "Викторина по Git", "icon": "$(git-branch)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "vibecoder.hello", "group": "navigation" },
        { "command": "vibecoder.countLines", "group": "navigation" },
        { "command": "jokeGenerator.getJoke", "group": "navigation" },
        { "command": "gitMaster.startQuiz", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "vibecoder.contextAction", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "18.x",
    "typescript": "^5.3.3"
  }
}